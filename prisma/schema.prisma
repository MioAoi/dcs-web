// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int     @id @default(autoincrement())
  username      String  @unique
  password      String
  nickname      String
  qqid          String? @unique
  pendingQqid   String? @unique
  qqBindToken   String?
  createdAt     DateTime @default(now())
  chargeMultiplier  Float   @default(1.0) 

  sessions      Session[]
  visits        Visit[]
  deposits      Deposit[]
  ledgerEntries Ledger[]
  paymentOrders  PaymentOrder[]
  coupons       Coupon[]

  role          Role    @default(CUSTOMER)
  balance       Int     @default(0)
  cashBalance   Int     @default(0)
  bonusBalance  Int     @default(0)
}

model Session {
  id        Int     @id @default(autoincrement())
  token     String  @unique
  userId    Int
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model Visit {
  id        Int     @id @default(autoincrement())
  userId    Int
  enteredAt DateTime
  leftAt    DateTime?
  charge    Int?
  token     String?

  ledgerEntry Ledger?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ledger {
  id        Int     @id @default(autoincrement())
  userId    Int
  user User @relation(fields: [userId], references: [id])
  
  cashChange   Int @default(0)
  bonusChange   Int @default(0)

  type      LedgerEntryType
  note      String?

  visitId    Int? @unique
  visit Visit? @relation(fields: [visitId], references: [id])

  deposit Deposit?
  paymentOrderId Int? @unique
  paymentOrder PaymentOrder? @relation(fields: [paymentOrderId], references: [id])
  
  createdAt DateTime @default(now())
}

model Deposit {
  id              Int @id @default(autoincrement())
  userId          Int
  dietName        String
  ledgerEntryId   Int @unique
  ledgerEntry     Ledger @relation(fields: [ledgerEntryId], references: [id])
  manualTimeStamp String?
  createdAt DateTime @default(now())

  paymentOrderId    Int? @unique
  user            User @relation(fields: [userId], references: [id])
}

model PaymentOrder {
  id              Int @id @default(autoincrement())
  orderNo         String @unique
  userId          Int
  user            User @relation(fields: [userId], references: [id])
  ledgerEntry     Ledger?
  amount          Int
  provider        String
  purpose         PaymentPurpose
  goodsName       String
  status          PaymentStatus

  createdAt DateTime @default(now())
  paidAt DateTime?

  payDirection String?
  bill          String?
  amountWcms    String?
}

model Coupon {
  id        Int     @id @default(autoincrement())
  token     String  @unique
  userId    Int
  goodsName  String
  amount    Int
  user      User    @relation(fields: [userId], references: [id])
}

enum LedgerEntryType {
  DEPOSIT
  VISIT_CHARGE
  REFUND
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentPurpose {
  DEPOSIT
  OTHER
}
